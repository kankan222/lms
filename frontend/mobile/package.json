{
  "name": "mobile",
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "start:local": "node scripts/run-expo-with-env.mjs .env start",
    "android:local": "node scripts/run-expo-with-env.mjs .env start --android",
    "ios:local": "node scripts/run-expo-with-env.mjs .env start --ios",
    "web:local": "node scripts/run-expo-with-env.mjs .env start --web",
    "start:server": "node scripts/run-expo-with-env.mjs .env.production start",
    "android:server": "node scripts/run-expo-with-env.mjs .env.production start --android",
    "ios:server": "node scripts/run-expo-with-env.mjs .env.production start --ios",
    "web:server": "node scripts/run-expo-with-env.mjs .env.production start --web",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
